# Smart Online Learning System — Environment Variables
# Copy this file to .env and update values for your environment.
# NEVER commit .env with real secrets to version control.

# Flask secret key (change this in production!)
SECRET_KEY=smartlearn-change-this-to-a-random-string

# Database path (SQLite for local dev)
DATABASE=smart_learn.db

# Cloud PostgreSQL Database URL (Render / Railway / Supabase)
# Leave unset or empty for local SQLite development
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Upload folder for teacher files
UPLOAD_FOLDER=uploads

# Emotion model file path
MODEL_PATH=models/emotion_model.joblib

# Email & SMTP Settings (Leave empty for local console fallback logging)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@smartlearn.com

# OTP Security Settings
OTP_EXPIRY_MINUTES=10
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
