# =========================================================================
# Smart Online Learning System — Environment Variables Template
# =========================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# NEVER commit .env with real secrets to version control.
# For Render deployment, configure these environment variables in the
# Render Dashboard: Service Settings -> Environment Variables.
# =========================================================================

# Flask Secret Key (REQUIRED in production: use a strong, random 32+ character string)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=smartlearn-change-this-to-a-random-string

# Environment Mode ('development' or 'production')
FLASK_ENV=development

# Application Base URL (used in email links, e.g. https://smartlearn.onrender.com)
APP_URL=http://localhost:5000

# Port for local server (Render provides $PORT dynamically)
PORT=5000

# -------------------------------------------------------------------------
# Database Configuration
# -------------------------------------------------------------------------
# For local SQLite development (default):
DATABASE=smart_learn.db

# For Production PostgreSQL on Render:
# Render automatically injects DATABASE_URL if linked to a PostgreSQL database.
# Format: postgresql://<user>:<password>@<host>:5432/<dbname>
# DATABASE_URL=postgresql://smartlearn_user:password@dpg-xxxx.render.com/smartlearn

# -------------------------------------------------------------------------
# Email Delivery Settings (Resend HTTP API or SMTP)
# -------------------------------------------------------------------------
# RECOMMENDED FOR RENDER & CLOUD DEPLOYMENTS:
# Render blocks outbound SMTP ports (25, 465, 587). Using an HTTP-based
# provider like Resend (https://resend.com) bypasses SMTP blocks completely.
# 1. Sign up for free at https://resend.com and generate an API key (re_xxxx)
# 2. For testing/onboarding without domain verification, use:
#    RESEND_FROM_EMAIL=SmartLearn <onboarding@resend.dev>
# 3. For your verified custom domain:
#    RESEND_FROM_EMAIL=SmartLearn <noreply@yourdomain.com>
RESEND_API_KEY=
RESEND_FROM_EMAIL=SmartLearn <onboarding@resend.dev>

# Fallback SMTP Settings (Used only if RESEND_API_KEY is not set)
# If neither Resend nor SMTP is configured, OTP codes are logged to console.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@smartlearn.com

# -------------------------------------------------------------------------
# OTP Security Settings
# -------------------------------------------------------------------------
OTP_EXPIRY_MINUTES=10
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# -------------------------------------------------------------------------
# Storage & Model Paths
# -------------------------------------------------------------------------
UPLOAD_FOLDER=uploads
MODEL_PATH=models/emotion_model.joblib
